# Keep #69 containment independent of whether a stale source is in a target list.
if(NOT DEFINED DUST3D_QUARANTINE_ROOT)
    get_filename_component(DUST3D_QUARANTINE_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
endif()
set(quarantine_header "${DUST3D_QUARANTINE_ROOT}/native/Engine/include/Dust3DBridge.h")
if(NOT EXISTS "${quarantine_header}")
    message(FATAL_ERROR "GLB catalog quarantine: public bridge header is missing")
endif()
file(READ "${quarantine_header}" quarantine_bridge)
if(quarantine_bridge MATCHES "dust3d_glb_material_catalog_|Dust3DGlbMaterialCatalog")
    message(FATAL_ERROR "GLB catalog quarantine (#69): unfinished C API must remain unavailable")
endif()
if(EXISTS "${DUST3D_QUARANTINE_ROOT}/native/Engine/GlbMaterialCatalog.cc")
    message(FATAL_ERROR "GLB catalog quarantine (#69): unfinished implementation was restored")
endif()
foreach(quarantine_manifest IN ITEMS Package.swift CMakeLists.txt)
    set(quarantine_manifest_path "${DUST3D_QUARANTINE_ROOT}/${quarantine_manifest}")
    if(EXISTS "${quarantine_manifest_path}")
        file(READ "${quarantine_manifest_path}" quarantine_manifest_text)
        if(quarantine_manifest_text MATCHES "GlbMaterialCatalog\\.cc")
            message(FATAL_ERROR "GLB catalog quarantine (#69): unfinished implementation was restored")
        endif()
        if(quarantine_manifest_text MATCHES "dust3d_json_(comparison_)?allocation_tests|contract_json_(comparison_)?allocation|json_(comparison_)?allocation_tests\\.cc")
            message(FATAL_ERROR "GLB catalog quarantine (#84): allocation-failure probes must remain unregistered")
        endif()
    endif()
endforeach()

# Core #84: known embedded fault cases stay in history, not default contracts.
foreach(quarantine_fault_source IN ITEMS imported_asset_tests.cc imported_surface_tests.cc source_baked_mesh_tests.cc generation_session_tests.cc)
    set(quarantine_fault_path "${DUST3D_QUARANTINE_ROOT}/tests/core/${quarantine_fault_source}")
    if(EXISTS "${quarantine_fault_path}")
        file(READ "${quarantine_fault_path}" quarantine_fault_text)
        if(quarantine_fault_text MATCHES "operator[ \t\r\n]+new|testOutputAllocationFailures|verifyLateAllocationFailures|allocationFailuresStayInsideC|cacheAllocationFailure|allocationBoundaries|failSnapshotAllocation")
            message(FATAL_ERROR "GLB catalog quarantine (#84): embedded allocation-failure cases were restored")
        endif()
    endif()
endforeach()

foreach(quarantine_probe_source IN ITEMS json_allocation_tests.cc json_comparison_allocation_tests.cc)
    if(EXISTS "${DUST3D_QUARANTINE_ROOT}/tests/core/${quarantine_probe_source}")
        message(FATAL_ERROR "GLB catalog quarantine (#84): historical allocation-failure probe source was restored")
    endif()
endforeach()
