if(NOT DEFINED QUARANTINE_CHECK OR NOT DEFINED TEST_WORK_ROOT)
    message(FATAL_ERROR "Supply QUARANTINE_CHECK and TEST_WORK_ROOT")
endif()
set(fixture "${TEST_WORK_ROOT}/glb-catalog-quarantine")
file(REMOVE_RECURSE "${fixture}")
file(MAKE_DIRECTORY "${fixture}/native/Engine/include")
set(header "${fixture}/native/Engine/include/Dust3DBridge.h")
file(WRITE "${header}" "/* Existing supported bridge. */\n")

function(expect_check should_pass)
    execute_process(COMMAND "${CMAKE_COMMAND}"
        "-DDUST3D_QUARANTINE_ROOT=${fixture}" -P "${QUARANTINE_CHECK}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(should_pass)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Safe source fixture rejected: ${output}${error}")
        endif()
    elseif(result EQUAL 0 OR NOT "${output}${error}" MATCHES "GLB catalog quarantine")
        message(FATAL_ERROR "Unsafe or incomplete source fixture was not rejected: ${output}${error}")
    endif()
endfunction()

expect_check(TRUE)
file(WRITE "${fixture}/Package.swift" "sources: [\"GlbReader.cc\"],\n")
file(WRITE "${fixture}/CMakeLists.txt" "native/Engine/GlbReader.cc\n")
expect_check(TRUE)
file(WRITE "${fixture}/Package.swift" "sources: [\"GlbMaterialCatalog.cc\"],\n")
expect_check(FALSE)
file(WRITE "${fixture}/Package.swift" "sources: [\"GlbReader.cc\"],\n")
file(WRITE "${fixture}/CMakeLists.txt" "native/Engine/GlbMaterialCatalog.cc\n")
expect_check(FALSE)
file(WRITE "${fixture}/CMakeLists.txt" "native/Engine/GlbReader.cc\n")
expect_check(TRUE)
file(WRITE "${header}" "void dust3d_glb_material_catalog_load(void);\n")
expect_check(FALSE)
file(WRITE "${header}" "typedef struct Dust3DGlbMaterialCatalog Dust3DGlbMaterialCatalog;\n")
expect_check(FALSE)
file(WRITE "${header}" "/* Existing supported bridge. */\n")
file(WRITE "${fixture}/native/Engine/GlbMaterialCatalog.cc" "/* Quarantined implementation. */\n")
expect_check(FALSE)
file(REMOVE "${fixture}/native/Engine/GlbMaterialCatalog.cc")
file(REMOVE "${header}")
expect_check(FALSE)
file(WRITE "${header}" "/* Existing supported bridge. */\n")
expect_check(TRUE)
message(STATUS "GLB catalog quarantine source-fixture checks passed")
