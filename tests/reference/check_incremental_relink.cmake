# Exercise the real reference/native build graph, not a copied miniature graph.
cmake_minimum_required(VERSION 3.20)
get_filename_component(source_root "${CMAKE_CURRENT_LIST_DIR}/../.." REALPATH)
if(NOT DEFINED REFERENCE_BUILD_DIR OR NOT DEFINED NATIVE_CORE_ARCHIVE)
    message(FATAL_ERROR "Set REFERENCE_BUILD_DIR and NATIVE_CORE_ARCHIVE")
endif()
set(source "${source_root}/dust3d/uv/uv_atlas_builder.cc")
set(executable "${REFERENCE_BUILD_DIR}/dust3d_qt_bake_reference${CMAKE_EXECUTABLE_SUFFIX}")
if(WIN32)
    set(executable "${REFERENCE_BUILD_DIR}/dust3d_qt_bake_reference.exe")
endif()
set(archive "${NATIVE_CORE_ARCHIVE}")
file(STRINGS "${REFERENCE_BUILD_DIR}/CMakeCache.txt" configured_source REGEX "^CMAKE_HOME_DIRECTORY:INTERNAL=")
string(REPLACE "CMAKE_HOME_DIRECTORY:INTERNAL=" "" configured_source "${configured_source}")
get_filename_component(configured_source "${configured_source}" REALPATH)
get_filename_component(expected_reference "${source_root}/tests/reference" REALPATH)
if(NOT configured_source STREQUAL expected_reference)
    message(FATAL_ERROR "Incremental probe must use this checkout's real reference project")
endif()
file(STRINGS "${REFERENCE_BUILD_DIR}/CMakeCache.txt" configured_native REGEX "^DUST3D_CORE_BUILD_DIR:PATH=")
string(REPLACE "DUST3D_CORE_BUILD_DIR:PATH=" "" configured_native "${configured_native}")
get_filename_component(configured_native "${configured_native}" REALPATH)
get_filename_component(archive_directory "${archive}" DIRECTORY)
get_filename_component(archive_directory "${archive_directory}" REALPATH)
if(NOT configured_native STREQUAL archive_directory)
    message(FATAL_ERROR "Incremental probe archive must belong to the configured native build")
endif()
function(build_reference)
    execute_process(COMMAND "${CMAKE_COMMAND}" --build "${REFERENCE_BUILD_DIR}"
        --target dust3d_qt_bake_reference --parallel 4
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Reference incremental build failed: ${output}\n${error}")
    endif()
endfunction()
build_reference()
file(SHA256 "${source}" before_hash)
file(TIMESTAMP "${archive}" before_archive "%s" UTC)
file(TIMESTAMP "${executable}" before_executable "%s" UTC)
if(before_archive STREQUAL "" OR before_executable STREQUAL "")
    message(FATAL_ERROR "Reference incremental probe needs built native and reference outputs")
endif()
# Whole-second timestamps keep the check portable across build tools/filesystems.
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 2 COMMAND_ERROR_IS_FATAL ANY)
file(TOUCH_NOCREATE "${source}")
build_reference()
file(SHA256 "${source}" after_hash)
file(TIMESTAMP "${archive}" after_archive "%s" UTC)
file(TIMESTAMP "${executable}" after_executable "%s" UTC)
if(NOT before_hash STREQUAL after_hash)
    message(FATAL_ERROR "Source contents changed during incremental probe; preserve and inspect the concurrent edit")
endif()
if(NOT after_archive GREATER before_archive)
    message(FATAL_ERROR "Native archive did not refresh; incremental relink regression was not exercised")
endif()
if(NOT after_executable GREATER before_executable OR after_executable LESS after_archive)
    message(FATAL_ERROR "Reference executable stayed stale after its native archive refreshed")
endif()
message(STATUS "Native archive refreshed and reference executable relinked; source contents unchanged")
